  "mutations": [
    {
      "name": "push_when_full",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire            push_ok  = push_i & ~full;",
      "to": "wire            push_ok  = push_i;",
      "expect": [
        "a_count",
        "a_no_ovfl",
        "a_full",
        "a_order"
      ],
      "depth": 12
    },
    {
      "name": "pop_when_empty",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire            pop_ok   = pop_i  & ~empty;",
      "to": "wire            pop_ok   = pop_i;",
      "expect": [
        "a_count",
        "a_empty"
      ],
      "depth": 12
    },
    {
      "name": "full_early",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire            full_nxt   = ~flush_i & push_ok & (count == DEPTH_M1);",
      "to": "wire            full_nxt   = ~flush_i & push_ok & (count == DEPTH_M1 - 1'b1);",
      "expect": [
        "a_full",
        "a_count"
      ],
      "depth": 12
    },
    {
      "name": "empty_wrong",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire            empty_nxt  =  flush_i | (~push_ok & (count == {{AW{1'b0}}, 1'b1}));",
      "to": "wire            empty_nxt  =  flush_i | (~push_ok & (count <= {{(AW-1){1'b0}}, 2'b10}));",
      "expect": [
        "a_empty",
        "a_head_0"
      ],
      "depth": 12
    },
    {
      "name": "flush_keeps_count",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire            count_en   = flush_i | (push_ok ^ pop_ok);",
      "to": "wire            count_en   = push_ok ^ pop_ok;",
      "expect": [
        "a_count"
      ],
      "depth": 12
    },
    {
      "name": "flush_keeps_rd_ptr",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire            rd_ptr_en  = flush_i | pop_ok;",
      "to": "wire            rd_ptr_en  = pop_ok;",
      "expect": [
        "a_order"
      ],
      "depth": 12
    },
    {
      "name": "write_on_flush",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "wire        mem_wr = push_ok & ~flush_i;",
      "to": "wire        mem_wr = push_i;",
      "expect": [
        "a_order"
      ],
      "depth": 12
    },
    {
      "name": "head_not_cleared",
