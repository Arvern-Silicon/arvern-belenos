      "to": "if (mem_wr) tag_mem[rd_ptr] <= wtag_i;",
      "expect": [
        "a_order_tag"
      ],
      "depth": 12
    },
    {
      "name": "tag_bit_lost",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "if (mem_wr) tag_mem[wr_ptr] <= wtag_i;",
      "to": "if (mem_wr) tag_mem[wr_ptr] <= {1'b0, wtag_i[0]};",
      "expect": [
        "a_order_tag"
      ],
      "depth": 12
    },
    {
      "name": "marker_tag_inverted",
      "task": "aw3_tag1",
      "file": "rtl:blns_gpu_fifo.v",
      "from": "if (mem_wr) tag_mem[wr_ptr] <= wtag_i;",
      "to": "if (mem_wr) tag_mem[wr_ptr] <= ~wtag_i;",
      "expect": [
