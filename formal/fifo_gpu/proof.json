      "file": "rtl:blns_gpu_fifo.v",
      "from": "assign head_o  = {32{~empty}} & mem[rd_ptr];",
      "to": "assign head_o  = mem[rd_ptr];",
      "expect": [
        "a_head_0"
      ],
      "depth": 12
    },
    {
      "name": "tag_not_cleared",
