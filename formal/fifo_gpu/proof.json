      "to": "assign head_tag_o = tag_mem[rd_ptr];",
      "expect": [
        "a_head_0"
      ],
      "depth": 12
    },
    {
      "name": "tag_wrong_slot",
      "task": "aw3_tag2",
      "file": "rtl:blns_gpu_fifo.v",
