      "cover_depth": 16,
      "probes": {
        "p_age_wait": "u_dut.G_AGE.age_wait"
      }
    },
    "lat3_reg1": {
      "params": {
        "RD_LAT": 3,
        "RD_REG_EN": 1
      },
      "depth": 14,
      "induction": true,
      "cover": true,
      "cover_depth": 16,
      "probes": {
        "p_age_wait": "u_dut.G_AGE.age_wait"
      }
    },
    "nogpu_lat2": {
      "params": {
        "RD_LAT": 2,
        "RD_REG_EN": 0,
        "GPU_EN": 0
      },
      "depth": 10,
      "induction": true,
      "cover": true,
      "note": "GPU_EN = 0: slot 1 not built"
    },
    "srst_lat3_reg1": {
      "params": {
        "RD_LAT": 3,
