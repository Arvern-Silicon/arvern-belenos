  "mutations": [
    {
      "name": "start_not_held",
      "task": "dpi_quick",
      "file": "rtl:blns_dpi_regs.v",
      "from": "assign pix_en_nxt = (cfg_en & (pix_en | ~run_h_i)) | (pix_en & ~run_h_i);",
      "to": "assign pix_en_nxt = cfg_en & (pix_en | ~run_h_i);",
      "expect": [
        "a_staged_stable"
      ],
      "depth": 14
    },
    {
      "name": "stop_unlocks_update",
      "task": "dpi",
      "file": "rtl:blns_dpi_regs.v",
      "from": "| (upd_pend & (pix_en | run_h_i));",
      "to": "| (upd_pend & pix_en);",
      "expect": [
        "a_staged_stable"
      ],
      "depth": 24,
      "keep_going": false
    },
    {
      "name": "lock_ignores_update",
      "task": "dpi_quick",
      "file": "rtl:blns_dpi_regs.v",
      "from": "assign st_lock    = start_lock | (upd_pend & (pix_en | run_h_i));",
      "to": "assign st_lock    = start_lock;",
      "expect": [
        "a_staged_stable"
      ],
      "depth": 24
    },
    {
      "name": "lock_ignores_start",
      "task": "dpi_quick",
      "file": "rtl:blns_dpi_regs.v",
      "from": "assign st_lock    = start_lock | (upd_pend & (pix_en | run_h_i));",
      "to": "assign st_lock    = (upd_pend & (pix_en | run_h_i));",
      "expect": [
        "a_staged_stable"
      ],
      "depth": 16
    },
    {
      "name": "update_while_pending",
      "task": "dpi_quick",
      "file": "rtl:blns_dpi_regs.v",
      "from": "assign upd_wr     = reg_wr & sel_ctrl & reg_wdata_i[0] & pix_en & ~st_lock;",
      "to": "assign upd_wr     = reg_wr & sel_ctrl & reg_wdata_i[0] & pix_en;",
      "expect": [
        "a_upd_handshake",
        "a_staged_stable"
      ],
      "depth": 24
    },
    {
      "name": "size_without_ack",
      "task": "dpi_quick",
      "file": "rtl:blns_dpi_bdi.v",
      "from": "assign sz_send   = prst_h_i & (sz_req_o == sz_ack_i) & ((fsz_w != sz_w_o) | (fsz_h != sz_h_o) | sz_rs);",
      "to": "assign sz_send   = prst_h_i & ((fsz_w != sz_w_o) | (fsz_h != sz_h_o) | sz_rs);",
      "expect": [
        "a_sz_handshake",
        "a_sz_stable",
        "a_sz_value"
      ],
      "depth": 16
    },
    {
      "name": "size_sampled_late",
      "task": "dpi_quick",
      "file": "rtl:blns_dpi_scan.v",
      "from": "    .d_i({sz_req_i, sz_w_i, sz_h_i}), .q_o({sz_ack, src_w, src_h}));",
      "to": "    .d_i({sz_req_i, sz_w_i ^ {DIM_W{sz_req_i ^ sz_ack}}, sz_h_i}), .q_o({sz_ack, src_w, src_h}));",
      "expect": [
        "a_sz_value"
      ],
      "depth": 16
    },
    {
      "name": "fields_unlocked",
      "task": "hdmi",
      "file": "rtl:blns_dpi_regs.v",
      "from": "        wire   fld_lock = start_lock | (hdmi_cfg[1] & upd_pend & (pix_en | run_h_i));",
      "to": "        wire   fld_lock = 1'b0;",
      "expect": [
        "a_fld_stable"
      ],
      "depth": 24
    },
    {
      "name": "fields_start_unlocked",
      "task": "hdmi",
      "file": "rtl:blns_dpi_regs.v",
      "from": "        wire   fld_lock = start_lock | (hdmi_cfg[1] & upd_pend & (pix_en | run_h_i));",
      "to": "        wire   fld_lock = hdmi_cfg[1] & upd_pend & (pix_en | run_h_i);",
      "expect": [
        "a_fld_stable"
      ],
      "depth": 16
    },
    {
      "name": "aud_unlocked",
      "task": "hdmi",
      "file": "rtl:blns_dpi_regs.v",
      "from": "            .clk_i(hclk_i), .rst_n_i(hresetn_i), .en_i(reg_wr & sel_aud & ~aud_lock),",
      "to": "            .clk_i(hclk_i), .rst_n_i(hresetn_i), .en_i(reg_wr & sel_aud),",
      "expect": [
        "a_aud_stable"
      ],
      "depth": 16
    },
    {
      "name": "aud_lock_on_active",
      "task": "hdmi",
      "edits": [
        [
          "rtl:blns_dpi_regs.v",
          "            wire aud_x_nxt = (aud_x == aud_echo_h_i) ? aud_ctl[0] : aud_x;",
          "            wire aud_x_nxt = aud_ctl[0];"
        ],
        [
          "rtl:blns_dpi_regs.v",
          "            assign aud_lock = aud_ctl[0] | aud_x | aud_echo_h_i;",
          "            assign aud_lock = aud_ctl[0] | aud_st_h_i[1];"
        ]
      ],
      "expect": [
        "a_aud_stable"
      ],
      "depth": 20
    },
    {
      "name": "aud_no_handshake",
      "task": "hdmi",
      "file": "rtl:blns_dpi_regs.v",
      "from": "            wire aud_x_nxt = (aud_x == aud_echo_h_i) ? aud_ctl[0] : aud_x;",
      "to": "            wire aud_x_nxt = aud_ctl[0];",
      "expect": [
        "a_aud_stable"
      ],
      "depth": 20
    },
    {
      "name": "fill_bank0_always",
      "task": "dpi",
      "file": "rtl:blns_dpi_bdi.v",
      "from": "assign wb_pick    = ~full_h & ~(~full_h - {{(NB-1){1'b0}}, 1'b1});",
      "to": "assign wb_pick    = {{(NB-1){1'b0}}, 1'b1};",
      "expect": [
        "a_bank_fill_rel",
        "a_tag_stable"
      ],
      "depth": 26,
      "keep_going": false
    },
    {
      "name": "tag_other_bank",
      "task": "dpi",
      "file": "rtl:blns_dpi_bdi.v",
      "from": "            .clk_i(hclk_i), .rst_n_i(hresetn_i), .en_i(px_take & wsel[gb] & wx_first),",
      "to": "            .clk_i(hclk_i), .rst_n_i(hresetn_i), .en_i(px_take & ~wsel[gb] & wx_first),",
      "expect": [
        "a_tag_stable"
      ],
      "depth": 26,
      "keep_going": false
    },
    {
      "name": "drop_writes",
      "task": "dpi",
      "file": "rtl:blns_dpi_bdi.v",
      "from": "assign px_take    = px_acc & ~drn;",
      "to": "assign px_take    = px_acc;",
      "expect": [
        "a_drop_no_write"
      ],
      "depth": 24,
      "keep_going": false
    },
    {
      "name": "frame_start_ignores_done",
      "task": "dpi",
      "file": "rtl:blns_dpi_bdi.v",
      "from": "assign fwait_nxt  = fs_evt_i & pix_en_i & active & ~drn & ~dn_evt_i;",
      "to": "assign fwait_nxt  = fs_evt_i & pix_en_i & active & ~drn;",
      "expect": [
        "a_done_order"
      ],
      "depth": 30,
      "keep_going": false
    },
    {
      "name": "no_prst_detect",
      "task": "dpi_prst",
      "file": "rtl:blns_dpi_regs.v",
      "from": "assign run_ok     = run_h_i & prst_h_i;",
      "to": "assign run_ok     = run_h_i;",
      "expect": [
        "a_staged_stable"
      ],
      "depth": 24
    }
  ],
