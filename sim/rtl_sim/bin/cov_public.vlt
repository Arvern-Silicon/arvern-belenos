//----------------------------------------------------------------------------
// File Name          : cov_public.vlt
// Module Description : Nets made public for the Verilator coverage build.
//----------------------------------------------------------------------------
// The smoke tests read no internal DUT net; only the bench variables shared
// between processes (monitor gate flags set by the test sequence, the panel
// models' frame arrays) are made public, so Verilator cannot hand a monitor a
// stale copy. Kept narrow on purpose: making everything public
// (--public-flat-rw) changes the scheduling of the gated clock.
public_flat_rw -module "tb_belenos" -var "*"
